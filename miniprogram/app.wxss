/* 向晚问思 - 全局纸感米色主题 */
page {
  background: #f3ede1;
  color: #2f2a22;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.7;
}

view, text, textarea, button {
  box-sizing: border-box;
}

/* 主题色 */
.c-paper { background: #f3ede1; }
.c-ink { color: #2f2a22; }
.c-accent { color: #9c3b2e; }
.c-muted { color: #8a8170; }

/* 通用按钮重置 */
button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
}
button::after { border: none; }
