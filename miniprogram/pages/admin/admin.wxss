page { background: #eee5d5; }

.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #eee5d5;
  color: #2d261c;
  box-sizing: border-box;
}

.whoami, .stats, .model-row, .model-form, .user-row, .detail {
  background: #fffaf0;
  border: 1rpx solid rgba(95, 70, 43, 0.16);
  border-radius: 8rpx;
  box-shadow: 0 8rpx 18rpx rgba(76, 53, 33, 0.05);
}
.whoami {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 18rpx;
}
.whoami-label { flex-shrink: 0; margin-right: 16rpx; font-size: 23rpx; color: #8a322a; font-weight: 700; }
.whoami-value { flex: 1; font-size: 23rpx; color: #473b2a; word-break: break-all; }

.stats { display: flex; padding: 24rpx 10rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; border-left: 1rpx solid rgba(95, 70, 43, 0.12); }
.stat:first-child { border-left: none; }
.stat-num { font-size: 46rpx; font-weight: 800; color: #9b2f25; font-variant-numeric: tabular-nums; }
.stat-label { font-size: 23rpx; color: #7a6d58; margin-top: 7rpx; }

.refresh { margin: 18rpx 0 24rpx; display: inline-block; padding: 10rpx 22rpx; background: #2f2a22; color: #fff8ea; border-radius: 7rpx; font-size: 25rpx; }
.refresh:active { transform: translateY(1rpx); }
.section-title { display: flex; align-items: center; justify-content: space-between; margin: 22rpx 4rpx 14rpx; font-size: 29rpx; font-weight: 800; color: #2d261c; }
.add-btn { padding: 7rpx 16rpx; border-radius: 6rpx; background: #9b2f25; color: #fff8ea; font-size: 23rpx; font-weight: 600; }
.empty { padding: 34rpx 20rpx; text-align: center; font-size: 25rpx; color: #8b7c64; }

.model-row { padding: 20rpx 22rpx; margin-bottom: 14rpx; }
.model-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.model-name { flex: 1; font-size: 29rpx; font-weight: 800; color: #2d261c; word-break: break-all; }
.model-state { flex-shrink: 0; font-size: 22rpx; color: #1f6e42; background: #e2f1e5; border-radius: 5rpx; padding: 3rpx 10rpx; }
.model-state.off { color: #7a6d58; background: #eee1ca; }
.model-sub { margin-top: 8rpx; font-size: 24rpx; color: #473b2a; }
.model-meta { margin-top: 6rpx; font-size: 21rpx; color: #8b7c64; word-break: break-all; }
.model-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22rpx; margin-top: 16rpx; }
.model-btn { font-size: 24rpx; color: #8a322a; font-weight: 600; }
.model-btn.danger { color: #b23a2d; }
.model-test { margin-top: 12rpx; padding: 12rpx 14rpx; border-radius: 6rpx; font-size: 22rpx; line-height: 1.55; word-break: break-all; }
.model-test.ok { background: #e2f1e5; color: #1f6e42; }
.model-test.err { background: #fae0dc; color: #a72f25; }

.model-form { padding: 20rpx; margin-bottom: 20rpx; }
.form-title { margin-bottom: 16rpx; font-size: 29rpx; font-weight: 800; color: #2d261c; }
.form-row { display: flex; align-items: center; margin-bottom: 15rpx; }
.form-label { width: 132rpx; flex-shrink: 0; font-size: 24rpx; color: #6c5d49; }
.form-input { flex: 1; min-height: 64rpx; padding: 11rpx 14rpx; border: 1rpx solid rgba(95, 70, 43, 0.16); border-radius: 6rpx; background: #fffefa; font-size: 25rpx; color: #2d261c; box-sizing: border-box; }
.form-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 10rpx; }
.form-btn { padding: 14rpx 30rpx; border-radius: 6rpx; background: #eee1ca; color: #5e5140; font-size: 25rpx; }
.form-btn.primary { background: #9b2f25; color: #fff8ea; }

.user-row { display: flex; align-items: center; padding: 20rpx 22rpx; margin-bottom: 12rpx; }
.user-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.user-id { font-size: 25rpx; color: #2d261c; word-break: break-all; }
.user-sub { margin-top: 6rpx; font-size: 22rpx; color: #7a6d58; }
.user-arrow { flex-shrink: 0; margin-left: 14rpx; color: #9b2f25; font-size: 34rpx; }

.detail { margin-top: 22rpx; padding: 20rpx; }
.detail-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.detail-title { font-size: 29rpx; font-weight: 800; color: #2d261c; }
.detail-close { font-size: 25rpx; color: #8a322a; }
.log-card { display: flex; flex-direction: column; padding: 18rpx 0; border-top: 1rpx solid rgba(95, 70, 43, 0.12); }
.log-q { font-size: 25rpx; color: #2d261c; line-height: 1.6; }
.log-a { margin-top: 8rpx; font-size: 24rpx; color: #5e5140; line-height: 1.6; }
.log-time { margin-top: 8rpx; font-size: 21rpx; color: #8b7c64; }

.insight-summary { margin: 14rpx 0 6rpx; font-size: 23rpx; color: #7a6d58; }
.insight-block { background: #fffaf0; border: 1rpx solid rgba(95, 70, 43, 0.16); border-radius: 8rpx; padding: 20rpx 22rpx; margin-bottom: 16rpx; box-shadow: 0 8rpx 18rpx rgba(76, 53, 33, 0.05); }
.insight-label { display: block; font-size: 25rpx; font-weight: 700; color: #8a322a; margin-bottom: 14rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-pill { font-size: 23rpx; color: #5e5140; background: #f0e6d2; border-radius: 30rpx; padding: 8rpx 18rpx; }
.q-item { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-top: 1rpx solid rgba(95, 70, 43, 0.12); }
.q-item:first-of-type { border-top: none; }
.q-text { flex: 1; min-width: 0; font-size: 25rpx; color: #2d261c; line-height: 1.55; margin-right: 16rpx; }
.q-count { flex-shrink: 0; font-size: 22rpx; color: #8a322a; font-weight: 700; }

/* Phase E-v2 — 回答质量反馈展示 */
.feedback-summary { display: flex; align-items: baseline; gap: 14rpx; }
.feedback-rate { font-size: 46rpx; font-weight: 800; color: #3c6b3c; }
.feedback-sub { font-size: 22rpx; color: #7a6d58; }
.tag-pill.warn { color: #8a322a; background: #f6e0d6; border: 1rpx solid rgba(138, 50, 42, 0.22); }

/* Phase F-1 — 百问分类进度（5 类桶） */
.cat-row { display: flex; align-items: center; gap: 14rpx; padding: 10rpx 0; }
.cat-name { flex-shrink: 0; width: 140rpx; font-size: 24rpx; color: #2d261c; }
.cat-bar { flex: 1; height: 16rpx; background: #f0e6d2; border-radius: 30rpx; overflow: hidden; }
.cat-fill { height: 100%; background: #8a322a; border-radius: 30rpx; }
.cat-count { flex-shrink: 0; width: 96rpx; text-align: right; font-size: 22rpx; color: #7a6d58; }

/* Phase F-2 — 定性补充（为什么有效/无效） */
.q-block { margin-top: 12rpx; }
.q-head { display: block; font-size: 23rpx; color: #7a5e36; margin-bottom: 6rpx; }
.q-line { display: flex; align-items: flex-start; justify-content: space-between; padding: 10rpx 0; border-top: 1rpx solid rgba(95, 70, 43, 0.12); }
.q-line:first-of-type { border-top: none; }
.q-text { flex: 1; min-width: 0; font-size: 24rpx; color: #2d261c; line-height: 1.55; margin-right: 16rpx; }
.q-count { flex-shrink: 0; font-size: 22rpx; color: #8a322a; font-weight: 700; }
