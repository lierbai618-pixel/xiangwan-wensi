<view class="page">
  <!-- 我的 openid（来自 whoami，点击查看） -->
  <view class="whoami" bindtap="copyOpenid">
    <text class="whoami-label">我的 openid</text>
    <text class="whoami-value">{{myOpenid || '加载中…'}}</text>
  </view>

  <!-- 统计卡 -->
  <view class="stats">
    <view class="stat">
      <text class="stat-num">{{stats.totalUsers}}</text>
      <text class="stat-label">总用户</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.totalChats}}</text>
      <text class="stat-label">总对话</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{stats.todayChats}}</text>
      <text class="stat-label">今日对话</text>
    </view>
  </view>

  <view class="refresh" bindtap="loadAll">刷新</view>

  <!-- 模型配置 -->
  <view class="section-title">
    模型配置
    <text class="add-btn" bindtap="openAddModel">+ 添加</text>
  </view>
  <view wx:if="{{models.length === 0}}" class="empty">暂无模型，点「+ 添加」配置一个大模型</view>
  <view wx:for="{{models}}" wx:key="_id" class="model-row">
    <view class="model-head">
      <text class="model-name">{{item.name}}</text>
      <text class="model-state {{item.enabled ? '' : 'off'}}">{{item.enabled ? '启用中' : '已停用'}}</text>
    </view>
    <view class="model-sub">{{item.model}}</view>
    <view class="model-meta">{{item.baseURL}} · {{item.timeout}}ms · 优先级 {{item.order}}{{item.note ? ' · ' + item.note : ''}}</view>
    <view class="model-actions">
      <switch checked="{{item.enabled}}" bindchange="onToggleEnabled" data-id="{{item._id}}" color="#9c3b2e" />
      <text class="model-btn" bindtap="testModel" data-id="{{item._id}}">测试</text>
      <text class="model-btn" bindtap="openEditModel" data-id="{{item._id}}">编辑</text>
      <text class="model-btn danger" bindtap="deleteModel" data-id="{{item._id}}">删除</text>
    </view>
    <view wx:if="{{item._testResult}}" class="model-test {{item._testOk ? 'ok' : 'err'}}">{{item._testResult}}</view>
  </view>

  <!-- 添加/编辑模型表单 -->
  <view wx:if="{{showModelForm}}" class="model-form">
    <view class="form-title">{{editingModel ? '编辑模型' : '添加模型'}}</view>
    <view class="form-row">
      <text class="form-label">显示名</text>
      <input class="form-input" value="{{modelForm.name}}" data-field="name" bindinput="onModelInput" placeholder="如 Flash" />
    </view>
    <view class="form-row">
      <text class="form-label">API Key</text>
      <input class="form-input" value="{{modelForm.apiKey}}" data-field="apiKey" bindinput="onModelInput" placeholder="百炼 API Key" />
    </view>
    <view class="form-row">
      <text class="form-label">接口地址</text>
      <input class="form-input" value="{{modelForm.baseURL}}" data-field="baseURL" bindinput="onModelInput" placeholder="https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1" />
    </view>
    <view class="form-row">
      <text class="form-label">模型名</text>
      <input class="form-input" value="{{modelForm.model}}" data-field="model" bindinput="onModelInput" placeholder="qwen-plus / qwen-max" />
    </view>
    <view class="form-row">
      <text class="form-label">超时(ms)</text>
      <input class="form-input" type="number" value="{{modelForm.timeout}}" data-field="timeout" bindinput="onModelInput" />
    </view>
    <view class="form-row">
      <text class="form-label">优先级</text>
      <input class="form-input" type="number" value="{{modelForm.order}}" data-field="order" bindinput="onModelInput" />
    </view>
    <view class="form-row">
      <text class="form-label">备注</text>
      <input class="form-input" value="{{modelForm.note}}" data-field="note" bindinput="onModelInput" placeholder="可选" />
    </view>
    <view class="form-row">
      <text class="form-label">启用</text>
      <switch checked="{{modelForm.enabled}}" bindchange="onFormEnabled" color="#9c3b2e" />
    </view>
    <view class="form-actions">
      <text class="form-btn" bindtap="closeModelForm">取消</text>
      <text class="form-btn primary" bindtap="saveModel">{{savingModel ? '保存中…' : '保存'}}</text>
    </view>
  </view>

  <!-- D-3 问题洞察 -->
  <view class="section-title">
    问题洞察
    <text class="add-btn" bindtap="loadInsights">刷新</text>
  </view>
  <view class="insight-summary">已收集 {{insights.totalQuestions}} 条真实提问</view>
  <view wx:if="{{insights.topTags.length === 0 && insights.topQuestions.length === 0}}" class="empty">暂无问题数据，去聊几句就有了</view>

  <view wx:if="{{insights.topTags.length > 0}}" class="insight-block">
    <text class="insight-label">高频主题</text>
    <view class="tag-list">
      <text wx:for="{{insights.topTags}}" wx:key="tag" class="tag-pill">#{{item.tag}} · {{item.count}}</text>
    </view>
  </view>

  <view wx:if="{{insights.topQuestions.length > 0}}" class="insight-block">
    <text class="insight-label">高频提问</text>
    <view wx:for="{{insights.topQuestions}}" wx:key="question" class="q-item">
      <text class="q-text">{{item.question}}</text>
      <text class="q-count">{{item.count}}</text>
    </view>
  </view>

  <!-- Phase F-1：百问分类进度（5 类桶），支撑 20/20/20/20/20 跟踪 -->
  <view wx:if="{{insights.categoryBreakdown && insights.categoryBreakdown.length > 0}}" class="insight-block">
    <text class="insight-label">百问分类进度</text>
    <view wx:for="{{insights.categoryBreakdown}}" wx:key="category" class="cat-row">
      <text class="cat-name">{{item.category}}</text>
      <view class="cat-bar"><view class="cat-fill" style="width:{{item.count > 20 ? 100 : item.count * 5}}%"></view></view>
      <text class="cat-count">{{item.count}}/20</text>
    </view>
  </view>

  <!-- E-5 回答质量反馈：我们真正要优化的是「用户是否觉得被帮助」 -->
  <view wx:if="{{insights.feedback && insights.feedback.total > 0}}" class="insight-block">
    <text class="insight-label">回答有帮助率</text>
    <view class="feedback-summary">
      <text class="feedback-rate">{{insights.feedback.rate}}%</text>
      <text class="feedback-sub">（{{insights.feedback.helpful}}/{{insights.feedback.total}} 条评价为「有用」）</text>
    </view>
    <view wx:if="{{insights.feedback.reasons.length > 0}}" class="tag-list">
      <text class="tag-pill warn" wx:for="{{insights.feedback.reasons}}" wx:key="reason">没帮助原因：{{item.reason}} · {{item.count}}</text>
    </view>
  </view>

  <!-- Phase F-2：定性反馈聚合（为什么有效/无效），用于优化理解层/行动库/引用策略 -->
  <view wx:if="{{insights.quality && insights.quality.total > 0}}" class="insight-block">
    <text class="insight-label">定性补充（为什么有效 / 无效）</text>
    <view wx:if="{{insights.quality.failures.length > 0}}" class="q-block">
      <text class="q-head">没帮到的地方</text>
      <view wx:for="{{insights.quality.failures}}" wx:key="text" class="q-line">
        <text class="q-text">{{item.text}}</text>
        <text class="q-count">{{item.count}}</text>
      </view>
    </view>
    <view wx:if="{{insights.quality.goods.length > 0}}" class="q-block">
      <text class="q-head">帮到的地方</text>
      <view wx:for="{{insights.quality.goods}}" wx:key="text" class="q-line">
        <text class="q-text">{{item.text}}</text>
        <text class="q-count">{{item.count}}</text>
      </view>
    </view>
  </view>

  <!-- 用户列表 -->
  <view class="section-title">用户列表</view>
  <view wx:if="{{users.length === 0}}" class="empty">暂无用户数据</view>
  <view wx:for="{{users}}" wx:key="openid" class="user-row" bindtap="openUser" data-openid="{{item.openid}}">
    <view class="user-main">
      <text class="user-id">{{item.openid}}</text>
      <text class="user-sub">对话 {{item.count}} 次 · 最近 {{item.lastActiveText}}</text>
    </view>
    <text class="user-arrow">›</text>
  </view>

  <!-- 用户对话详情 -->
  <view wx:if="{{currentUser}}" class="detail">
    <view class="detail-head">
      <text class="detail-title">用户对话</text>
      <text class="detail-close" bindtap="closeUser">收起</text>
    </view>
    <view wx:for="{{currentLogs}}" wx:key="id" class="log-card">
      <text class="log-q">问：{{item.message}}</text>
      <text class="log-a">答：{{item.answer}}</text>
      <text class="log-time">{{item.timeText}}</text>
    </view>
  </view>
</view>
