page { background: #efe4cf; }

.page {
  min-height: 100vh;
  padding: 28rpx 26rpx 42rpx;
  box-sizing: border-box;
  background: #efe4cf;
  color: #2d261c;
}

.hero {
  position: relative;
  padding: 34rpx 30rpx 32rpx;
  margin-bottom: 22rpx;
  background: #2f2a22;
  color: #fff8ea;
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 38rpx rgba(58, 40, 24, 0.18);
}
.hero::after {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border: 2rpx solid rgba(217, 178, 111, 0.35);
  transform: rotate(18deg);
}
.hero-kicker { font-size: 22rpx; color: #d9b26f; margin-bottom: 14rpx; }
.hero-title { font-size: 58rpx; font-weight: 800; line-height: 1.05; }
.hero-sub { margin-top: 18rpx; max-width: 620rpx; font-size: 27rpx; line-height: 1.72; color: #ded2bd; }

.section {
  margin-bottom: 20rpx;
  padding: 26rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.16);
  border-radius: 8rpx;
  box-shadow: 0 8rpx 18rpx rgba(76, 53, 33, 0.06);
}
.section-label {
  display: inline-block;
  margin-bottom: 16rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid #9b2f25;
  font-size: 25rpx;
  font-weight: 700;
  color: #8a322a;
}
.section-label.light { border-color: #d9b26f; color: #f2d39c; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-count { font-size: 23rpx; color: #8b7c64; }
.para { display: block; margin-bottom: 14rpx; font-size: 28rpx; line-height: 1.82; color: #4a3f2f; }

.quote-panel { background: #9b2f25; border: none; color: #fff8ea; }
.quote-text { font-size: 36rpx; line-height: 1.66; font-weight: 700; }
.quote-from { margin-top: 14rpx; font-size: 24rpx; color: #f0c7ad; text-align: right; }
.quote-refresh { display: inline-block; margin-top: 20rpx; padding: 8rpx 20rpx; border: 1rpx solid rgba(255, 248, 234, 0.42); border-radius: 6rpx; font-size: 24rpx; color: #fff8ea; }
.quote-refresh:active { background: rgba(255, 255, 255, 0.08); }

.steps { display: flex; flex-direction: column; gap: 14rpx; }
.step { display: flex; align-items: flex-start; padding: 16rpx 0; border-top: 1rpx solid rgba(126, 93, 52, 0.12); }
.step:first-child { border-top: none; padding-top: 0; }
.step-num { width: 58rpx; flex-shrink: 0; font-size: 24rpx; font-weight: 800; color: #9b2f25; font-variant-numeric: tabular-nums; }
.step-text { flex: 1; font-size: 27rpx; line-height: 1.65; color: #4a3f2f; }

.catalog { display: flex; flex-wrap: wrap; gap: 12rpx; }
.catalog-item { font-size: 23rpx; color: #4d402e; background: #f1e4cf; border: 1rpx solid rgba(115, 83, 49, 0.12); border-radius: 6rpx; padding: 8rpx 14rpx; }

.ops { display: flex; gap: 18rpx; margin: 24rpx 0 18rpx; }
.op-btn {
  flex: 1;
  width: auto;
  margin: 0;
  padding: 21rpx 0;
  border-radius: 8rpx;
  border: 1rpx solid rgba(115, 83, 49, 0.2);
  background: #fffaf0;
  color: #8a322a;
  font-size: 28rpx;
  line-height: 1.4;
  text-align: center;
  box-sizing: border-box;
}
.op-btn.primary { background: #2f2a22; color: #fff8ea; border-color: #2f2a22; }
.op-btn::after { border: none; }
.op-btn:active { transform: translateY(1rpx); }

.admin-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #eadcc5;
  border: 1rpx solid rgba(115, 83, 49, 0.16);
  border-radius: 8rpx;
  font-size: 27rpx;
  color: #4a3f2f;
}
.admin-arrow { color: #9b2f25; font-weight: 700; }
.legal-links { text-align: center; margin-top: 28rpx; padding-bottom: 10rpx; }
.legal-link { font-size: 25rpx; color: #8a322a; padding: 0 10rpx; }
.legal-sep { font-size: 24rpx; color: #9f9078; }
