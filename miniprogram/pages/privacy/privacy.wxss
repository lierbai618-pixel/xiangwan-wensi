page { background: #efe4cf; }

.page {
  min-height: 100vh;
  background: #efe4cf;
  display: flex;
  flex-direction: column;
  color: #2d261c;
}

.tabs {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 10rpx;
  padding: 18rpx 22rpx;
  background: #efe4cf;
  border-bottom: 1rpx solid rgba(83, 56, 33, 0.14);
  box-sizing: border-box;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #7a6d58;
  background: #f5ead8;
  border-radius: 7rpx;
}
.tab.on {
  color: #fff8ea;
  background: #2f2a22;
  font-weight: 700;
}

.doc {
  flex: 1;
  padding: 30rpx 28rpx 64rpx;
  box-sizing: border-box;
}
.doc-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #2d261c;
  line-height: 1.3;
  margin-bottom: 10rpx;
}
.doc-meta {
  display: inline-block;
  font-size: 23rpx;
  color: #7a6d58;
  background: #f5ead8;
  border-radius: 5rpx;
  padding: 7rpx 12rpx;
  margin-bottom: 24rpx;
}
.lead {
  display: block;
  font-size: 28rpx;
  line-height: 1.85;
  color: #473b2a;
  background: #fffaf0;
  border-left: 7rpx solid #9b2f25;
  border-radius: 7rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 26rpx;
}
.sec-h {
  font-size: 31rpx;
  font-weight: 800;
  color: #8a322a;
  margin: 34rpx 0 14rpx;
}
.p, .li {
  display: block;
  font-size: 28rpx;
  line-height: 1.86;
  color: #3f3526;
  margin: 8rpx 0;
}
.li { padding-left: 4rpx; }
.p.tip {
  color: #6a512a;
  background: #fff4dd;
  border-radius: 7rpx;
  padding: 16rpx 18rpx;
  margin-top: 12rpx;
}
.doc-foot {
  text-align: center;
  font-size: 25rpx;
  color: #9f9078;
  margin-top: 44rpx;
  padding-bottom: 18rpx;
}
