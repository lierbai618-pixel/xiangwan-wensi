<view class="page">
  <view class="head">
    <text class="head-title">经典阅读</text>
    <text class="head-sub">10 本已入库的公版经典，思想来源可溯源</text>
  </view>

  <view class="list">
    <view
      wx:for="{{books}}"
      wx:key="id"
      class="book {{activeId === item.id ? 'open' : ''}}"
      bindtap="toggleDetail"
      data-id="{{item.id}}"
    >
      <view class="book-row">
        <view class="book-main">
          <text class="book-title">《{{item.title}}》</text>
          <text class="book-author">{{item.author}} · {{item.perspective}}</text>
        </view>
        <text class="book-arrow">{{activeId === item.id ? '收起' : '详情'}}</text>
      </view>
      <view wx:if="{{activeId === item.id}}" class="book-detail">
        <view class="book-intro">{{item.intro}}</view>
        <view class="book-sample">“{{item.sample}}”</view>
      </view>
    </view>
  </view>

  <view class="foot">引用均来自以上经典；解读与原文严格区分。</view>
</view>
