page { background: #efe4cf; }

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #efe4cf;
  color: #2d261c;
}

.head { margin-bottom: 24rpx; }
.head-title { display: block; font-size: 40rpx; font-weight: 800; color: #2d261c; }
.head-sub { display: block; font-size: 24rpx; color: #7a6d58; margin-top: 8rpx; }

.list { display: flex; flex-direction: column; gap: 16rpx; }

.book {
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.16);
  border-radius: 12rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 8rpx 18rpx rgba(76, 53, 33, 0.06);
}
.book.open { border-color: #b99052; }

.book-row { display: flex; align-items: center; justify-content: space-between; }
.book-main { display: flex; flex-direction: column; min-width: 0; }
.book-title { font-size: 31rpx; font-weight: 700; color: #2d261c; }
.book-author { font-size: 23rpx; color: #8b7c64; margin-top: 6rpx; }
.book-arrow { flex-shrink: 0; font-size: 24rpx; color: #9b2f25; margin-left: 16rpx; }

.book-detail { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(126, 93, 52, 0.16); }
.book-intro { font-size: 26rpx; line-height: 1.7; color: #4a4031; }
.book-sample {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #8a322a;
  background: #f5ecd8;
  border-left: 5rpx solid #b99052;
  padding: 14rpx 18rpx;
  border-radius: 6rpx;
}

.foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 23rpx;
  color: #8b7c64;
}
