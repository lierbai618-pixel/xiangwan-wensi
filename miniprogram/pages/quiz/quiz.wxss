page { background: #efe4cf; }
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 70rpx;
  box-sizing: border-box;
  background: #efe4cf;
  color: #2d261c;
}

.hero { text-align: center; margin-bottom: 40rpx; }
.hero-kicker { font-size: 24rpx; color: #9b2f25; letter-spacing: 4rpx; }
.hero-title { font-size: 50rpx; font-weight: 800; margin-top: 14rpx; }
.hero-sub { font-size: 25rpx; color: #7a6d58; margin-top: 16rpx; line-height: 1.75; text-align: left; }
.hl { color: #9b2f25; font-weight: 700; }

.group { margin-bottom: 40rpx; }
.group-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding-left: 6rpx;
}
.group-name { font-size: 30rpx; font-weight: 700; color: #2d261c; }
.group-desc { font-size: 22rpx; color: #9b8c74; }

.link-list { display: flex; flex-direction: column; gap: 20rpx; }

.link-card {
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.18);
  border-radius: 14rpx;
  padding: 26rpx;
  box-shadow: 0 14rpx 32rpx rgba(76, 53, 33, 0.07);
}

.link-name { font-size: 30rpx; font-weight: 600; color: #2d261c; line-height: 1.45; }
.link-note { font-size: 22rpx; color: #9b8c74; margin-top: 8rpx; }

/* 2026-09-22：网址直接展示，长按选中即可复制（不再调用剪贴板隐私接口） */
.link-url {
  display: block;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6b5a3e;
  background: rgba(115, 83, 49, 0.07);
  border-radius: 8rpx;
  word-break: break-all;
}

.tip {
  text-align: center;
  margin-top: 30rpx;
  font-size: 22rpx;
  color: #9b8c74;
  line-height: 1.7;
}
