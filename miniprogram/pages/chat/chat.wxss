page { background: #efe4cf; }

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #efe4cf;
  color: #2d261c;
  overflow: hidden;
}

.page::before {
  content: "";
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0.42;
  background-image:
    linear-gradient(rgba(91, 58, 33, 0.055) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(91, 58, 33, 0.035) 1rpx, transparent 1rpx);
  background-size: 36rpx 36rpx;
}

.topbar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx 18rpx;
  background: #efe4cf;
  border-bottom: 1rpx solid rgba(83, 56, 33, 0.16);
}

.brand { display: flex; align-items: center; min-width: 0; }
.brand-mark {
  width: 66rpx;
  height: 66rpx;
  border-radius: 10rpx;
  background: #9b2f25;
  color: #fff8ea;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  box-shadow: 0 10rpx 22rpx rgba(84, 31, 23, 0.18);
}
.brand-text { display: flex; flex-direction: column; min-width: 0; }
.brand-title { font-size: 34rpx; font-weight: 700; color: #2d261c; line-height: 1.15; }
.brand-sub { font-size: 22rpx; color: #7a6d58; margin-top: 4rpx; }
.top-actions { flex-shrink: 0; display: flex; align-items: center; }
.top-btn {
  font-size: 25rpx;
  color: #8a322a;
  background: rgba(255, 250, 238, 0.62);
  border: 1rpx solid rgba(139, 72, 43, 0.2);
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  margin-left: 14rpx;
}
.top-btn.primary { color: #fff7e8; background: #9b2f25; border-color: #9b2f25; }
.top-btn:active { transform: translateY(1rpx); }

.intro-panel {
  position: relative;
  z-index: 1;
  margin: 22rpx 24rpx 4rpx;
  padding: 24rpx 26rpx;
  background: #2f2a22;
  color: #fff7e8;
  border-radius: 8rpx;
  box-shadow: 0 16rpx 34rpx rgba(65, 45, 27, 0.16);
}
.intro-kicker { font-size: 22rpx; color: #d9b26f; margin-bottom: 8rpx; }
.intro-title { font-size: 36rpx; line-height: 1.32; font-weight: 700; }
.intro-copy { margin-top: 10rpx; font-size: 25rpx; line-height: 1.6; color: #d9d0bd; }

.chat-scroll {
  position: relative;
  z-index: 1;
  flex: 1;
  padding: 22rpx 24rpx 10rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.msg-row { display: flex; align-items: flex-start; margin-bottom: 28rpx; }
.msg-row.user { flex-direction: row-reverse; }
.speaker {
  width: 46rpx;
  height: 46rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 4rpx;
}
.speaker.assistant { color: #8a322a; background: #fff8ea; border: 1rpx solid #dec8a6; }
.speaker.user { color: #fff8ea; background: #2f2a22; }

.bubble {
  max-width: calc(100% - 82rpx);
  padding: 22rpx 24rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  line-height: 1.76;
  word-break: break-word;
  white-space: pre-wrap;
  box-sizing: border-box;
}
.msg-row.assistant .bubble { margin-left: 14rpx; }
.msg-row.user .bubble { margin-right: 14rpx; }
.bubble.assistant {
  background: #fffaf0;
  color: #2d261c;
  border: 1rpx solid rgba(115, 83, 49, 0.18);
  box-shadow: 0 8rpx 18rpx rgba(76, 53, 33, 0.08);
}
.bubble.user {
  background: #9b2f25;
  color: #fff9ef;
  box-shadow: 0 10rpx 22rpx rgba(90, 33, 25, 0.18);
}
.bubble.loading { color: #6c5d49; display: flex; align-items: center; }

.loading-dots { display: flex; gap: 7rpx; margin-left: 12rpx; }
.loading-dots text {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #9b2f25;
  animation: pulse 1.1s infinite ease-in-out;
}
.loading-dots text:nth-child(2) { animation-delay: 0.15s; }
.loading-dots text:nth-child(3) { animation-delay: 0.3s; }
.typing-cursor {
  display: inline-block;
  width: 7rpx;
  height: 30rpx;
  background: #9b2f25;
  margin-left: 5rpx;
  vertical-align: text-bottom;
  animation: blink 1s steps(2, start) infinite;
}
@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
@keyframes pulse { 0%, 80%, 100% { opacity: 0.32; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-4rpx); } }

.model-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 3rpx 12rpx;
  background: #efe4cf;
  border: 1rpx solid #dcc39d;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #7a5e36;
}
.model-tag.local { color: #645b4b; background: #f3ead8; }
.debug-note {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  background: #fff1d6;
  border-left: 5rpx solid #b57932;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #7a4d1e;
  line-height: 1.55;
}

.cites { margin-top: 18rpx; border-top: 1rpx solid rgba(126, 93, 52, 0.18); padding-top: 14rpx; }
.cite-toggle { font-size: 24rpx; color: #9b2f25; font-weight: 600; }
.cite-list { margin-top: 10rpx; }
.cite-item { padding: 14rpx 0; border-bottom: 1rpx solid rgba(126, 93, 52, 0.12); }
.cite-header { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.cite-title { font-size: 26rpx; color: #2d261c; font-weight: 600; }
.cite-meta { font-size: 22rpx; color: #8b7c64; }
.cite-arrow { margin-left: auto; flex-shrink: 0; font-size: 22rpx; color: #9b2f25; }
.cite-body { margin-top: 12rpx; padding: 16rpx; background: #f5ecd8; border-radius: 6rpx; border-left: 5rpx solid #b99052; }
.cite-section { display: block; font-size: 23rpx; color: #8a322a; font-weight: 600; margin-bottom: 8rpx; }
.cite-text { display: block; font-size: 25rpx; color: #423726; line-height: 1.75; white-space: pre-wrap; }
.cite-tags { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.cite-tag { font-size: 20rpx; color: #7a5e36; background: #fff9ee; padding: 3rpx 10rpx; border-radius: 4rpx; }

.topics { position: relative; z-index: 2; padding: 12rpx 0 6rpx; background: rgba(239, 228, 207, 0.96); border-top: 1rpx solid rgba(83, 56, 33, 0.12); }
.topic-scroll { white-space: nowrap; padding: 0 20rpx; box-sizing: border-box; }
.topic-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  margin-right: 14rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.18);
  border-radius: 7rpx;
  font-size: 25rpx;
  color: #433828;
}
.topic-dot { width: 8rpx; height: 8rpx; background: #9b2f25; margin-right: 10rpx; }
.topic-chip:active { background: #f7ead3; }

.composer {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: flex-end;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #eadcc5;
  border-top: 1rpx solid rgba(83, 56, 33, 0.16);
  box-sizing: border-box;
}
.input {
  flex: 1;
  min-height: 76rpx;
  max-height: 210rpx;
  padding: 17rpx 20rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.2);
  border-radius: 8rpx;
  font-size: 29rpx;
  line-height: 1.5;
  color: #2d261c;
  box-sizing: border-box;
}
.input-ph { color: #a3947a; }
.send-btn {
  margin-left: 14rpx;
  padding: 0 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: #2f2a22;
  color: #fff8ea;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.send-btn:active { transform: translateY(1rpx); }
.send-btn.disabled { opacity: 0.45; }

.privacy-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 54rpx;
  box-sizing: border-box;
  background: rgba(35, 27, 18, 0.58);
}
.privacy-card { width: 100%; background: #fffaf0; border-radius: 8rpx; padding: 38rpx 34rpx 30rpx; box-shadow: 0 18rpx 48rpx rgba(29, 21, 14, 0.24); }
.privacy-title { font-size: 34rpx; font-weight: 700; color: #2d261c; margin-bottom: 22rpx; }
.privacy-body { margin-bottom: 28rpx; }
.privacy-p { display: block; font-size: 27rpx; line-height: 1.78; color: #5d5140; margin-bottom: 14rpx; }
.privacy-link { color: #9b2f25; font-weight: 600; }
.privacy-actions { display: flex; gap: 18rpx; }
.privacy-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 8rpx; font-size: 28rpx; }
.privacy-btn.ghost { color: #6d604d; background: #f1e5d1; }
.privacy-btn.primary { color: #fff8ea; background: #9b2f25; font-weight: 600; }

.mode-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 3rpx 12rpx;
  background: #efe4cf;
  border: 1rpx solid #dcc39d;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #7a5e36;
}
.mode-tag.local { color: #645b4b; background: #f3ead8; }

/* Phase Q2-2 — 三模式回答徽标（🌐普通 / 📚深度 / 🌅思考） */
.ans-mode-tag {
  display: inline-block;
  margin-top: 12rpx;
  margin-right: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.4;
}
.ans-mode-tag.am-fast { color: #3c6b3c; background: rgba(60, 107, 60, 0.12); border: 1rpx solid rgba(60, 107, 60, 0.32); }
.ans-mode-tag.am-deep { color: #9b2f25; background: rgba(155, 47, 37, 0.1); border: 1rpx solid rgba(155, 47, 37, 0.28); }
.ans-mode-tag.am-think { color: #9a6a14; background: rgba(217, 178, 111, 0.2); border: 1rpx solid rgba(185, 144, 82, 0.42); }

.mode-bar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 14rpx 22rpx 12rpx;
  background: #eadcc5;
  box-sizing: border-box;
}
.mode-label { font-size: 23rpx; color: #8b7c64; margin-right: 16rpx; flex-shrink: 0; }
.mode-chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.mode-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.2);
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #433828;
}
.mode-chip.active { background: #2f2a22; color: #fff8ea; border-color: #2f2a22; }
.mode-chip:active { transform: translateY(1rpx); }
.mode-ico { font-size: 28rpx; line-height: 1; }
.mode-name { line-height: 1; }
.mode-desc { width: 100%; margin-top: 10rpx; font-size: 21rpx; line-height: 1.5; color: #8b7c64; }

.ai-disclaimer {
  position: relative;
  z-index: 3;
  padding: 10rpx 26rpx 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #9b2f25;
  opacity: 0.78;
  background: #eadcc5;
  text-align: center;
  box-sizing: border-box;
}

.cite-sec { font-size: 23rpx; color: #8a322a; font-weight: 500; margin-left: 4rpx; }

/* Phase E-2 思想路线卡 */
.route {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: #f5ecd8;
  border: 1rpx solid rgba(126, 93, 52, 0.22);
  border-left: 5rpx solid #9b2f25;
  border-radius: 8rpx;
}
.route-head { font-size: 22rpx; color: #8a322a; font-weight: 600; letter-spacing: 1rpx; }
.route-dims { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.route-dim {
  font-size: 24rpx;
  color: #423726;
  background: #fff9ee;
  border: 1rpx solid #e2cfa8;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
}
.route-books { margin-top: 12rpx; display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; }
.route-lead { font-size: 22rpx; color: #7a5e36; margin-right: 4rpx; }
.route-book { font-size: 23rpx; color: #8a322a; font-weight: 600; }
.route-core { margin-top: 12rpx; font-size: 24rpx; color: #5a4c37; line-height: 1.7; }

/* Phase E-v2 — 引用解释层（E-4） */
.cite-explain {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  background: #fbf4e4;
  border: 1rpx solid #e7d4ab;
  border-radius: 6rpx;
}
.cite-why { display: flex; align-items: baseline; margin-bottom: 10rpx; font-size: 23rpx; color: #4a3f2e; line-height: 1.65; }
.cite-why:last-child { margin-bottom: 0; }
.cite-explain-label {
  flex-shrink: 0;
  margin-right: 14rpx;
  padding: 2rpx 10rpx;
  background: #9b2f25;
  color: #fff8ea;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.cite-why-text { flex: 1; }

/* Phase E-v2 — 回答质量反馈（E-5） */
.feedback {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: #f5ecd8;
  border: 1rpx solid rgba(126, 93, 52, 0.22);
  border-radius: 8rpx;
}
.fb-q { font-size: 24rpx; color: #5a4c37; margin-bottom: 12rpx; }
.fb-actions { display: flex; gap: 14rpx; }
.fb-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.22);
}
.fb-btn:active { transform: translateY(1rpx); }
.fb-btn.up { color: #3c6b3c; }
.fb-btn.down { color: #9b2f25; }
.fb-reasons { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.fb-reason {
  font-size: 22rpx;
  color: #433828;
  background: #fff9ee;
  border: 1rpx solid #e2cfa8;
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
}
.fb-reason:active { background: #f1e2c6; }
.feedback-done { margin-top: 14rpx; font-size: 23rpx; color: #7a5e36; }

/* Phase F · answer_quality_log 可选定性补充（为什么有效/无效） */
.quality { margin-top: 12rpx; padding: 14rpx 16rpx; background: #fbf4e4; border: 1rpx solid #e7d4ab; border-radius: 6rpx; }
.quality-toggle { font-size: 23rpx; color: #8a322a; line-height: 1.6; }
.quality-input { width: 100%; min-height: 88rpx; margin-top: 12rpx; padding: 14rpx; font-size: 24rpx; color: #2d261c; background: #fffdf8; border: 1rpx solid #e2cfa6; border-radius: 6rpx; box-sizing: border-box; }
.quality-submit { margin-top: 12rpx; display: inline-block; padding: 12rpx 30rpx; font-size: 24rpx; color: #fff; background: #8a322a; border-radius: 30rpx; }
.quality-done { margin-top: 12rpx; font-size: 23rpx; color: #3c6b3c; }

/* Phase X — 先贤视角选择器 */
.sage-bar {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 12rpx 22rpx 6rpx;
  background: #eadcc5;
  box-sizing: border-box;
}
.sage-scroll { width: 100%; white-space: nowrap; padding: 8rpx 0 4rpx; box-sizing: border-box; }
.sage-chip {
  display: inline-block;
  padding: 9rpx 20rpx;
  margin-right: 12rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.2);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #433828;
}
.sage-chip.active { background: #9b2f25; color: #fff8ea; border-color: #9b2f25; font-weight: 600; }
.sage-chip:active { transform: translateY(1rpx); }
.sage-active {
  width: 100%;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8a322a;
}
.sage-clear { color: #9b2f25; font-weight: 600; }

/* Phase X — 人格回应徽标 */
.persona-tag {
  display: inline-block;
  margin-top: 12rpx;
  margin-right: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #8a322a;
  background: rgba(155, 47, 37, 0.1);
  border: 1rpx solid rgba(155, 47, 37, 0.28);
}
.persona-tag.socratic { color: #5a4c37; background: rgba(217, 178, 111, 0.2); border-color: rgba(185, 144, 82, 0.42); }

/* Phase X — 回答操作（收藏 / 复制 / 收藏夹） */
.ans-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(126, 93, 52, 0.16);
}
.ans-act {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 23rpx;
  color: #433828;
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.2);
  border-radius: 8rpx;
}
.ans-act:active { transform: translateY(1rpx); background: #f7ead3; }
.ans-act.on { color: #fff8ea; background: #9b2f25; border-color: #9b2f25; }

/* 情绪出口（P0）：先贤抚慰卡 —— 暖色、柔和、区别于常规气泡 */
.comfort-card {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 26rpx;
  background: linear-gradient(135deg, #fff7ec, #fdeede);
  border: 1rpx solid rgba(199, 145, 86, 0.35);
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(170, 120, 70, 0.12);
}
.comfort-head {
  font-size: 23rpx;
  color: #b07a3c;
  margin-bottom: 12rpx;
  font-weight: 600;
}
.comfort-quote {
  font-size: 30rpx;
  line-height: 1.6;
  color: #4a3a28;
  font-weight: 600;
}
.comfort-src {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9b8159;
  text-align: right;
}
.comfort-text {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5c4a36;
}
.comfort-tip {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(176, 122, 60, 0.3);
  font-size: 20rpx;
  line-height: 1.5;
  color: #a07b52;
}

/* 情绪出口（P0）：危机护栏卡 —— 醒目警示色，强调「你很重要」与热线 */
.crisis-card {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 26rpx;
  background: #fff1f0;
  border: 2rpx solid #e8745f;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(200, 90, 70, 0.18);
}
.crisis-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #c0392b;
  margin-bottom: 12rpx;
}
.crisis-line {
  font-size: 26rpx;
  line-height: 1.7;
  color: #5a3a36;
  margin-bottom: 8rpx;
}
.crisis-hotlines {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.crisis-hotline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(192, 57, 43, 0.3);
  border-radius: 12rpx;
}
.crisis-h-name { font-size: 25rpx; color: #4a3a36; }
.crisis-h-tel { font-size: 27rpx; font-weight: 700; color: #c0392b; letter-spacing: 1rpx; }
.crisis-note {
  margin-top: 14rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #a85a4a;
}
