<view class="page">
  <view class="topbar">
    <view class="brand">
      <view class="brand-mark">问</view>
      <view class="brand-text">
        <text class="brand-title">向晚问思</text>
        <text class="brand-sub">经典思辨助手</text>
      </view>
    </view>
    <view class="top-actions">
      <view class="top-btn" bindtap="openSessions">会话</view>
      <view class="top-btn" bindtap="onSettings">设置</view>
      <view class="top-btn primary" bindtap="newConversation">新对话</view>
    </view>
  </view>

  <view wx:if="{{showTopics}}" class="intro-panel">
    <view class="intro-kicker">从经典与现实两端一起想</view>
    <view class="intro-title">选择一个切入点，或直接写下你眼下最卡住的问题。</view>
    <view class="intro-copy">经典不替你做决定，只帮你把问题看得更清楚。</view>
  </view>

  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg-row {{item.role}}">
      <view wx:if="{{item._type !== 'comfort' && item._type !== 'crisis'}}" class="speaker {{item.role}}">{{item.role === 'user' ? '我' : '问'}}</view>

      <view wx:if="{{item._type === 'comfort'}}" class="comfort-card">
        <view class="comfort-head">🫂 先贤说 · 关于「{{item.emotion}}」</view>
        <view class="comfort-quote">「{{item.quote}}」</view>
        <view class="comfort-src">—— {{item.author}}《{{item.source}}》</view>
        <view class="comfort-text">{{item.interpretation}}</view>
        <view class="comfort-tip">{{item.disclaimer}}</view>
      </view>

      <view wx:if="{{item._type === 'crisis'}}" class="crisis-card">
        <view class="crisis-head">🆘 {{item.title}}</view>
        <view wx:for="{{item.lines}}" wx:for-item="ln" wx:key="*this" class="crisis-line">{{ln}}</view>
        <view class="crisis-hotlines">
          <view wx:for="{{item.hotlines}}" wx:for-item="h" wx:key="tel" class="crisis-hotline">
            <text class="crisis-h-name">{{h.name}}</text>
            <text class="crisis-h-tel">{{h.tel}}</text>
          </view>
        </view>
        <view class="crisis-note">{{item.note}}</view>
      </view>

      <view wx:if="{{item._type !== 'comfort' && item._type !== 'crisis'}}" class="bubble {{item.role}}">
        <text class="bubble-text" user-select="{{true}}">{{item.content}}</text><view wx:if="{{item._typing}}" class="typing-cursor"></view>

        <view wx:if="{{item._answerModeLabel}}" class="ans-mode-tag am-{{item._answerMode}}">{{item._answerModeLabel}}</view>

        <view wx:if="{{item.sage && item.sage !== 'none'}}" class="persona-tag">📜 {{item.sageName || '先贤'}}视角</view>
        <view wx:if="{{item.socratic}}" class="persona-tag socratic">🔍 苏格拉底追问</view>

        <view wx:if="{{item._reqModeLabel}}" class="mode-tag {{item._mode === 'local' ? 'local' : ''}}">{{item._reqModeLabel}}{{item._mode === 'model' ? ' · 模型' : ' · 本地'}}</view>
        <view wx:elif="{{item._mode === 'model' && item._modelUsed}}" class="mode-tag">{{item._modelUsed}}</view>
        <view wx:elif="{{item._mode === 'local'}}" class="mode-tag local">本地检索</view>

        <view wx:if="{{item._modelError}}" class="debug-note">模型未生效：{{item._modelError}}。已使用本地检索回答。</view>

        <!-- 2026-09-21 CR-精简问答卡片（第三轮）：以下两块 UI 已移除
             ① route 卡片：原渲染「你的问题可能涉及」标签 + 「推荐阅读」书目 + route.core 一句
             ② feedback 卡片：原渲染「这条回答对你有帮助吗？」+ 👍/👎 + 负面原因标签 + 完成后致谢行
             ⚠️ 注意：后端仍会返回 route 字段（rag.js buildRoute），仅前端不再渲染；
                feedback 云函数同理保留，但已无前端调用方。
             回滚：从 .CR20260921C-bak/chat.wxml 恢复。 -->

        <!-- Phase F · answer_quality_log：可选定性补充（为什么有效/无效），不打断主流程 -->
        <view wx:if="{{item.role === 'assistant' && item._isAnswer && item._feedback != null && !item._showReasons}}" class="quality">
          <view wx:if="{{!item._qualityDone}}" class="quality-toggle" bindtap="toggleQuality" data-id="{{item.id}}">{{item._qualityOpen ? '收起补充' : '补充（可选）：这条回答哪里帮到你 / 没帮到你？'}}</view>
          <block wx:if="{{item._qualityOpen}}">
            <textarea class="quality-input" placeholder="哪里没帮到你？（例如：太抽象 / 没针对我的情况 / 引用太多）" value="{{item._qualityFailure}}" bindinput="onQualityInput" data-id="{{item.id}}" data-field="failure" maxlength="200" auto-height />
            <textarea class="quality-input" placeholder="哪里帮到你了？（例如：行动建议具体 / 共情到位）" value="{{item._qualityGood}}" bindinput="onQualityInput" data-id="{{item.id}}" data-field="good" maxlength="200" auto-height />
            <view class="quality-submit" bindtap="submitQuality" data-id="{{item.id}}">提交补充</view>
          </block>
          <view wx:if="{{item._qualityDone}}" class="quality-done">已收到你的补充，非常感谢，这会帮我们改进「向晚问思」。</view>
        </view>

        <view wx:if="{{item.role === 'assistant' && item.citations.length > 0}}" class="cites">
          <view class="cite-toggle" bindtap="toggleCites" data-id="{{item.id}}">
            {{item._citesOpen ? '收起思想来源' : '查看思想来源'}}（{{item.citations.length}}）
          </view>
          <view wx:if="{{item._citesOpen}}" class="cite-list">
            <view wx:for="{{item.citations}}" wx:for-item="c" wx:key="id" class="cite-item {{c._textOpen ? 'expanded' : ''}}" bindtap="toggleCiteText" data-msg-id="{{item.id}}" data-cite-title="{{c.title}}">
              <view class="cite-header">
                <text class="cite-title">《{{c.title}}》<text wx:if="{{c.section}}" class="cite-sec">· {{c.section}}</text></text>
                <text class="cite-arrow">{{c._textOpen ? '收起原文' : '查看原文'}}</text>
              </view>
              <view wx:if="{{c._textOpen}}" class="cite-body">
                <text wx:if="{{c.section}}" class="cite-section">{{c.section}}</text>
                <text class="cite-text" user-select="{{true}}">{{c.text || c.summary || '暂无原文内容'}}</text>
                <view class="cite-explain">
                  <view class="cite-why"><text class="cite-explain-label">为什么引用</text><text class="cite-why-text">{{c.why}}</text></view>
                  <view class="cite-why"><text class="cite-explain-label">核心思想</text><text class="cite-why-text">{{c.principle}}</text></view>
                  <view class="cite-why"><text class="cite-explain-label">现实启发</text><text class="cite-why-text">{{c.inspiration}}</text></view>
                </view>
                <view wx:if="{{c.tags && c.tags.length > 0}}" class="cite-tags">
                  <text wx:for="{{c.tags}}" wx:key="*this" class="cite-tag">#{{item}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{item.role === 'assistant' && item._isAnswer}}" class="ans-actions">
        <view class="ans-act {{item._faved ? 'on' : ''}}" catchtap="toggleFav" data-id="{{item.id}}">{{item._faved ? '★ 已收藏' : '☆ 收藏'}}</view>
        <view class="ans-act" catchtap="copyAnswer" data-id="{{item.id}}">⧉ 查看</view>
        <view class="ans-act" catchtap="goFavorites">📚 收藏夹</view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="msg-row assistant">
      <view class="speaker assistant">问</view>
      <view class="bubble assistant loading">
        <text>正在整理依据</text>
        <view class="loading-dots"><text></text><text></text><text></text></view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{showTopics}}" class="topics">
    <scroll-view scroll-x class="topic-scroll" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{topics}}" wx:key="tag" class="topic-chip" bindtap="useTopic" data-prompt="{{item.prompt}}">
        <text class="topic-dot"></text>{{item.label}}
      </view>
    </scroll-view>
  </view>

  <view class="sage-bar">
    <text class="mode-label">先贤视角</text>
    <scroll-view scroll-x class="sage-scroll" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{sages}}"
        wx:key="key"
        class="sage-chip {{sage === item.key ? 'active' : ''}}"
        bindtap="setSage"
        data-sage="{{item.key}}"
      >{{item.name}}</view>
    </scroll-view>
    <view wx:if="{{sage !== 'none'}}" class="sage-active">已选「{{sageName}}」：将以 TA 的口吻回应 · <text class="sage-clear" catchtap="setSage" data-sage="none">取消</text></view>
    <view wx:if="{{sage === 'none' && sageDesc}}" class="mode-desc">{{sageDesc}}</view>
  </view>

  <view class="mode-bar">
    <text class="mode-label">回答模式</text>
    <view class="mode-chips">
      <view
        wx:for="{{answerModes}}"
        wx:key="key"
        class="mode-chip {{answerMode === item.key ? 'active' : ''}}"
        bindtap="setAnswerMode"
        data-mode="{{item.key}}"
      >
        <text class="mode-ico">{{item.icon}}</text>
        <text class="mode-name">{{item.label}}</text>
      </view>
    </view>
    <view wx:if="{{modeDesc}}" class="mode-desc">{{modeDesc}}</view>
  </view>

  <view class="ai-disclaimer">本对话由 AI 生成，内容仅供参考，不构成心理咨询、医疗或法律等专业建议。</view>

  <view class="composer">
    <textarea
      class="input"
      value="{{inputValue}}"
      bindinput="onInput"
      placeholder="写下你的处境、疑问或想讨论的一段原文"
      placeholder-class="input-ph"
      auto-height
      maxlength="600"
      adjust-position="{{true}}"
      cursor-spacing="20"
    />
    <view class="send-btn {{loading ? 'disabled' : ''}}" bindtap="onSend">发送</view>
  </view>

  <view wx:if="{{showPrivacy}}" class="privacy-mask">
    <view class="privacy-card">
      <view class="privacy-title">隐私政策与用户协议</view>
      <view class="privacy-body">
        <text class="privacy-p">为提供问答与会话保存服务，我们会收集匿名标识 OpenID、对话内容和必要运行日志，不获取昵称、头像、手机号等信息。</text>
        <text class="privacy-p">请阅读完整的<text class="privacy-link" catchtap="openPrivacy" data-tab="privacy">《隐私政策》</text>与<text class="privacy-link" catchtap="openPrivacy" data-tab="terms">《用户协议》</text>。点击同意即表示你已阅读并接受全部条款。</text>
      </view>
      <view class="privacy-actions">
        <view class="privacy-btn ghost" catchtap="declinePrivacy">不同意</view>
        <view class="privacy-btn primary" catchtap="agreePrivacy">同意并继续</view>
      </view>
    </view>
  </view>
</view>
