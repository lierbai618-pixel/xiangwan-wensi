<view class="page">
  <view class="topbar">
    <view class="title">会话</view>
    <view class="new-btn" bindtap="newSession">+ 新对话</view>
  </view>

  <scroll-view class="list" scroll-y>
    <view wx:if="{{sessions.length === 0 && !loading}}" class="empty">
      还没有会话，点右上角「新对话」开始。
    </view>
    <view
      wx:for="{{sessions}}"
      wx:key="_id"
      class="session-item {{item.active ? 'active' : ''}}"
    >
      <view class="session-main" bindtap="openSession" data-id="{{item._id}}">
        <view class="session-title">{{item.title}}</view>
        <view class="session-time">{{item.timeText}}</view>
      </view>
      <view class="session-del" catchtap="removeSession" data-id="{{item._id}}">删除</view>
    </view>
  </scroll-view>
</view>
