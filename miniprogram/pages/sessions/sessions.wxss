page { background: #efe4cf; }
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #efe4cf;
  color: #2d261c;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx 18rpx;
  background: #efe4cf;
  border-bottom: 1rpx solid rgba(83, 56, 33, 0.16);
}
.title { font-size: 34rpx; font-weight: 700; color: #2d261c; }
.new-btn {
  font-size: 26rpx;
  color: #fff7e8;
  background: #9b2f25;
  border-radius: 8rpx;
  padding: 12rpx 22rpx;
}
.new-btn:active { transform: translateY(1rpx); }
.list { flex: 1; padding: 18rpx 24rpx; box-sizing: border-box; }
.empty { text-align: center; color: #7a6d58; font-size: 26rpx; margin-top: 80rpx; }
.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff8ea;
  border: 1rpx solid rgba(139, 72, 43, 0.14);
  border-radius: 10rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
}
.session-item.active {
  border-color: #9b2f25;
  box-shadow: 0 8rpx 18rpx rgba(84, 31, 23, 0.12);
}
.session-main { flex: 1; min-width: 0; }
.session-title {
  font-size: 28rpx;
  color: #2d261c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.session-time { font-size: 22rpx; color: #7a6d58; margin-top: 6rpx; }
.session-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #a32d2d;
  margin-left: 20rpx;
  padding: 8rpx 12rpx;
}
