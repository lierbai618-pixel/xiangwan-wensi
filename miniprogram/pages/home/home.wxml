<view class="page">
  <view class="hero">
    <view class="hero-mark">问</view>
    <view class="hero-text">
      <text class="hero-title">向晚问思</text>
      <text class="hero-sub">以经典为镜，陪你思考人生</text>
    </view>
  </view>

  <view class="section-label">今日思考</view>
  <view class="thought-card" wx:if="{{thought.quote}}">
    <view class="thought-theme">{{thought.theme}}</view>
    <view class="thought-quote">“{{thought.quote}}”</view>
    <view class="thought-source">—— 《{{thought.source.title}}》· {{thought.source.chapter}}</view>
    <view class="thought-q">🤔 {{thought.question}}</view>
    <view class="thought-change" bindtap="changeThought">换一张</view>
  </view>

  <view class="entries">
    <view class="entry-card primary hero-card" bindtap="goChat">
      <view class="entry-icon">💬</view>
      <view class="entry-title">人生问题</view>
      <view class="entry-desc">把眼下的困惑说出来，一起看清它</view>
    </view>
    <view class="entry-row">
      <view class="entry-card" bindtap="goDaily">
        <view class="entry-icon">🌇</view>
        <view class="entry-title">每日一思</view>
        <view class="entry-desc">每日一张经典卡，照一照今天的心</view>
      </view>
      <view class="entry-card" bindtap="goQuiz">
        <view class="entry-icon">🔮</view>
        <view class="entry-title">人格测试</view>
        <view class="entry-desc">MBTI 等经典测试，多面认识自己</view>
      </view>
      <!-- 2026-09-21 CR-删除卜算子模块（第四轮）：卜算子入口卡片已移除。
           同步移出构建范围：pages/busuanzi/、data/hexagrams.js、data/tarot.js
           回滚：从 .CR20260921D-removed/ 恢复文件，并还原本文件与 app.json。
           注：后端 chat 的 shensuanzi 人格分支**刻意保留**（向后兼容旧版本客户端）。 -->
    </view>
  </view>

  <view class="foot">我不是来替你做决定的，而是陪你一起想清楚。</view>

  <!-- 隐私授权浮层（全局入口，首次进入时展示） -->
  <view wx:if="{{showPrivacy}}" class="privacy-mask">
    <view class="privacy-card">
      <view class="privacy-title">隐私政策与用户协议</view>
      <view class="privacy-body">
        <text class="privacy-p">为提供问答与会话保存服务，我们会收集匿名标识 OpenID、对话内容和必要运行日志，不获取昵称、头像、手机号等信息。</text>
        <text class="privacy-p">你的问题文本（经脱敏处理后）将传输至第三方 AI 模型服务商（经 api.hcnsec.cn 网关转发，含 Agnes、阿里云百炼等，服务器位于中国境内）进行 AI 推理与联网搜索。详见<text class="privacy-link" catchtap="openPrivacy" data-tab="privacy">《隐私政策》</text>第四条。</text>
        <text class="privacy-p">请阅读完整的<text class="privacy-link" catchtap="openPrivacy" data-tab="privacy">《隐私政策》</text>与<text class="privacy-link" catchtap="openPrivacy" data-tab="terms">《用户协议》</text>。点击同意即表示你已阅读并接受全部条款。</text>
      </view>
      <view class="privacy-actions">
        <view class="privacy-btn ghost" catchtap="declinePrivacy">不同意</view>
        <view class="privacy-btn primary" catchtap="agreePrivacy">同意并继续</view>
      </view>
    </view>
  </view>
</view>
