page { background: #efe4cf; }

.page {
  min-height: 100vh;
  padding: 44rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #efe4cf;
  color: #2d261c;
}

.hero {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}
.hero-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 14rpx;
  background: #2f2a22;
  color: #fff8ea;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 12rpx 26rpx rgba(47, 42, 34, 0.22);
}
.hero-text { display: flex; flex-direction: column; }
.hero-title { font-size: 52rpx; font-weight: 800; color: #2d261c; letter-spacing: 4rpx; }
.hero-sub { font-size: 26rpx; color: #7a6d58; margin-top: 8rpx; }

.section-label {
  font-size: 26rpx;
  color: #8a322a;
  font-weight: 700;
  margin: 8rpx 0 16rpx;
  letter-spacing: 2rpx;
}

.thought-card {
  background: #2f2a22;
  color: #fff7e8;
  border-radius: 14rpx;
  padding: 34rpx 32rpx 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(47, 42, 34, 0.18);
}
.thought-theme {
  display: inline-block;
  font-size: 22rpx;
  color: #d9b26f;
  background: rgba(217, 178, 111, 0.16);
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  margin-bottom: 18rpx;
}
.thought-quote {
  font-size: 34rpx;
  line-height: 1.7;
  font-weight: 600;
  color: #fff8ea;
}
.thought-source {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #c9b48f;
}
.thought-q {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #f3e6cc;
  border-left: 5rpx solid #b99052;
  padding-left: 18rpx;
}
.thought-change {
  margin-top: 22rpx;
  text-align: right;
  font-size: 24rpx;
  color: #d9b26f;
}

.entries {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 40rpx;
}
.entry-card {
  box-sizing: border-box;
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.18);
  border-radius: 18rpx;
  padding: 34rpx 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(76, 53, 33, 0.09);
  transition: transform .15s ease, box-shadow .15s ease;
}
.entry-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 6rpx 16rpx rgba(76, 53, 33, 0.1);
}
.entry-card.primary {
  background: #9b2f25;
  border-color: #9b2f25;
}
.entry-card.hero-card {
  width: 100%;
  padding: 44rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.entry-row {
  display: flex;
  gap: 22rpx;
}
.entry-row .entry-card {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.entry-icon { font-size: 48rpx; margin-bottom: 16rpx; }
.entry-card.hero-card .entry-icon { font-size: 60rpx; margin-bottom: 18rpx; }
.entry-title { font-size: 34rpx; font-weight: 700; color: #2d261c; }
.entry-card.primary .entry-title { color: #fff8ea; }
.entry-card.hero-card .entry-title { font-size: 40rpx; }
.entry-desc { margin-top: 12rpx; font-size: 25rpx; line-height: 1.55; color: #6c5d49; }
.entry-card.primary .entry-desc { color: #f4d9cf; }
.entry-card.hero-card .entry-desc { font-size: 28rpx; }

.foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8b7c64;
  line-height: 1.6;
}

/* 隐私授权浮层 */
.privacy-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 54rpx;
  box-sizing: border-box;
  background: rgba(35, 27, 18, 0.58);
}
.privacy-card { width: 100%; background: #fffaf0; border-radius: 8rpx; padding: 38rpx 34rpx 30rpx; box-shadow: 0 18rpx 48rpx rgba(29, 21, 14, 0.24); }
.privacy-title { font-size: 34rpx; font-weight: 700; color: #2d261c; margin-bottom: 22rpx; }
.privacy-body { margin-bottom: 28rpx; }
.privacy-p { display: block; font-size: 27rpx; line-height: 1.78; color: #5d5140; margin-bottom: 14rpx; }
.privacy-link { color: #9b2f25; font-weight: 600; }
.privacy-actions { display: flex; gap: 18rpx; }
.privacy-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 8rpx; font-size: 28rpx; }
.privacy-btn.ghost { color: #6d604d; background: #f1e5d1; }
.privacy-btn.primary { color: #fff8ea; background: #9b2f25; font-weight: 600; }
