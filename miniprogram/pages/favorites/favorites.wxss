page { background: #efe4cf; }
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 70rpx;
  box-sizing: border-box;
  background: #efe4cf;
  color: #2d261c;
}

.hero { text-align: center; margin-bottom: 34rpx; }
.hero-kicker { font-size: 24rpx; color: #9b2f25; letter-spacing: 4rpx; }
.hero-title { font-size: 42rpx; font-weight: 800; margin-top: 12rpx; }
.hero-sub { font-size: 25rpx; color: #7a6d58; margin-top: 12rpx; }

.empty { text-align: center; margin-top: 120rpx; }
.empty-emoji { font-size: 90rpx; }
.empty-text { margin-top: 20rpx; font-size: 30rpx; color: #5a4d3c; }
.empty-tip { margin-top: 12rpx; font-size: 24rpx; color: #9b8c74; }

.list { display: flex; flex-direction: column; gap: 22rpx; }
.fav-card {
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.18);
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 32rpx rgba(76, 53, 33, 0.1);
}
.fav-head { padding: 28rpx 30rpx; }
.fav-tags { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 14rpx; }
.fav-tag {
  font-size: 20rpx;
  color: #fff8ea;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
}
.fav-tag.sage { background: #9b2f25; }
.fav-tag.socratic { background: #7a5cab; }
.fav-tag.mode { background: #b07a3e; }
.fav-q {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d261c;
  line-height: 1.5;
}
.fav-toggle { margin-top: 14rpx; font-size: 22rpx; color: #9b8c74; }

.fav-body { border-top: 1rpx solid rgba(126, 93, 52, 0.14); padding: 26rpx 30rpx 22rpx; background: #fbf4e4; }
.fav-answer {
  font-size: 27rpx;
  line-height: 1.74;
  color: #433828;
  white-space: pre-wrap;
}
.fav-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.fav-act {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #8a322a;
  background: #f3ead8;
  border: 1rpx solid rgba(139, 72, 43, 0.22);
}
.fav-act.danger { color: #a32d2d; }
.fav-act:active { transform: translateY(1rpx); }
