<view class="page">
  <view class="hero">
    <view class="hero-kicker">向晚问思 · 收藏夹</view>
    <view class="hero-title">收藏的回答</view>
    <view class="hero-sub">那些打动你的句子，留在这里慢慢回看。</view>
  </view>

  <view wx:if="{{empty && !loading}}" class="empty">
    <view class="empty-emoji">📭</view>
    <view class="empty-text">还没有收藏任何回答</view>
    <view class="empty-tip">在对话里点 ☆ 即可收藏</view>
  </view>

  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="_id" class="fav-card">
      <view class="fav-head" bindtap="toggle" data-id="{{item._id}}">
        <view class="fav-tags">
          <text wx:if="{{item.sage && item.sage !== 'none'}}" class="fav-tag sage">先贤视角</text>
          <text wx:if="{{item.socratic}}" class="fav-tag socratic">苏格拉底</text>
          <text wx:if="{{item.answerMode}}" class="fav-tag mode">{{item.answerMode}}</text>
        </view>
        <view class="fav-q">{{item.question || '（无提问）'}}</view>
        <view class="fav-toggle">{{item._open ? '收起 ▲' : '展开 ▼'}}</view>
      </view>
      <view wx:if="{{item._open}}" class="fav-body">
        <view class="fav-answer">{{item.answer}}</view>
        <view class="fav-actions">
          <view class="fav-act" bindtap="goChatWithFav" data-id="{{item._id}}">带去对话</view>
          <view class="fav-act danger" bindtap="remove" data-id="{{item._id}}">移除</view>
        </view>
      </view>
    </view>
  </view>
</view>
