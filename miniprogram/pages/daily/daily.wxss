page { background: #efe4cf; }
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  background: #efe4cf;
  color: #2d261c;
}

.hero { text-align: center; margin-bottom: 36rpx; }
.hero-kicker { font-size: 24rpx; color: #9b2f25; letter-spacing: 4rpx; }
.hero-date { font-size: 40rpx; font-weight: 700; margin-top: 12rpx; }
.hero-sub { font-size: 25rpx; color: #7a6d58; margin-top: 10rpx; line-height: 1.6; }

.card {
  background: #fffaf0;
  border: 1rpx solid rgba(115, 83, 49, 0.18);
  border-radius: 14rpx;
  padding: 44rpx 38rpx 36rpx;
  box-shadow: 0 18rpx 40rpx rgba(76, 53, 33, 0.12);
}
.card-theme {
  display: inline-block;
  font-size: 22rpx;
  color: #fff8ea;
  background: #9b2f25;
  padding: 5rpx 18rpx;
  border-radius: 30rpx;
  margin-bottom: 26rpx;
}
.card-quote {
  font-size: 38rpx;
  line-height: 1.74;
  font-weight: 600;
  color: #2d261c;
  letter-spacing: 1rpx;
}
.card-source { margin-top: 22rpx; font-size: 25rpx; color: #8a322a; text-align: right; }

.card-divider { height: 1rpx; background: rgba(126, 93, 52, 0.18); margin: 34rpx 0 26rpx; }

.card-q-label { font-size: 22rpx; color: #7a6d58; letter-spacing: 2rpx; }
.card-question { margin-top: 12rpx; font-size: 30rpx; line-height: 1.74; color: #433828; }

.card-actions { display: flex; gap: 16rpx; margin-top: 38rpx; }
.card-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
}
.card-btn.ghost { color: #8a322a; background: #f3ead8; border: 1rpx solid rgba(139, 72, 43, 0.22); }
.card-btn.primary { color: #fff8ea; background: #9b2f25; }
.card-btn:active { transform: translateY(1rpx); }

.tip { text-align: center; margin-top: 30rpx; font-size: 22rpx; color: #9b8c74; }
