<view class="page">
  <view class="hero">
    <view class="hero-kicker">向晚问思 · 每日一思</view>
    <view class="hero-date">{{dateLabel}}</view>
    <view class="hero-sub">黄昏时刻，借一句经典，照一照今天的心。</view>
  </view>

  <view wx:if="{{card}}" class="card">
    <view class="card-theme">{{card.theme}}</view>
    <view class="card-quote">「{{card.quote}}」</view>
    <view class="card-source">—— {{card.source.title}} · {{card.source.author}} · {{card.source.chapter}}</view>

    <view class="card-divider"></view>

    <view class="card-q-label">今日一问</view>
    <view class="card-question">{{card.question}}</view>

    <view class="card-actions">
      <view class="card-btn ghost" bindtap="changeCard">换一张</view>
      <view class="card-btn ghost" bindtap="copyQuote">查看原文</view>
      <view class="card-btn primary" bindtap="goChat">带去对话</view>
    </view>
  </view>

  <view class="tip">第 {{idx + 1}} / {{total}} 张 · 每日 0 点自动更新</view>
</view>
