# ============================================================
# Caddyfile —— 向晚问思 SearXNG 公网出口
#   · 自动申请/续期 Let's Encrypt 证书（需 80 端口可访问 + 域名已备案）。
#   · 反向代理到本机 127.0.0.1:8080（SearXNG 仅监听本机）。
#   · Bearer Token 校验：云函数 domesticFreeSearch.js 发送
#     "Authorization: Bearer <SEARXNG_API_KEY>"，此处必须一致。
#
# ⚠️ 部署前：
#   1) 将 search.example.com 改为你的真实已备案域名。
#   2) 将下方 REPLACE_WITH_YOUR_KEY 改为与云函数 SEARXNG_API_KEY 相同的密钥。
#   3) { email } 改为你的运维邮箱（证书注册联系人）。
# ============================================================

{
  email admin@example.com
}

search.example.com {
  # 无有效 Bearer Token 一律拒绝（SearXNG 本身不做鉴权，由 Caddy 兜底）
  reverse_proxy 127.0.0.1:8080 {
    @noauth not header Authorization "Bearer REPLACE_WITH_YOUR_KEY"
    respond @noauth "unauthorized" 401
  }

  # 安全响应头
  header {
    Strict-Transport-Security "max-age=31536000;"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
  }
}
