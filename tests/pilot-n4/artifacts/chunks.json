  "chunks": [
    {
      "chunk_id": "pilot::P-04::c001",
      "knowledge_id": "P-04",
      "namespace": "pilot",
      "level": "child",
      "section": "定义",
      "position": 0,
      "content": "确认偏差是指人在搜集、解释和回忆信息时，系统性地偏向于支持自己既有信念或假设的证据，同时低估、忽略或苛责与之相反的证据。它不是有意欺骗，而是一种在意识之外自动运行的认知倾向。",
      "content_length": 87,
      "source_position": "0-87",
      "metadata_complete": true,
      "vec_dim": 1024
    },
    {
      "chunk_id": "pilot::P-04::c002",
      "knowledge_id": "P-04",
      "namespace": "pilot",
      "level": "child",
      "section": "经典研究来源",
      "position": 1,
      "content": "沃森（Peter C. Wason）在 1960 年的「2-4-6 规则发现任务」中发现：被试倾向于提出能够验证自己假设的例子，而很少主动提出可能推翻假设的例子。尼克森（Raymond S. Nickerson）在 1998 年发表于《General Psychology Review》的综述中，把确认偏差概括为一种跨情境普遍存在的现象，涵盖信息搜索、证据解读与记忆提取三个环节。",
      "content_length": 191,
      "source_position": "0-191",
      "metadata_complete": true,
      "vec_dim": 1024
    },
    {
      "chunk_id": "pilot::P-04::c003",
      "knowledge_id": "P-04",
      "namespace": "pilot",
      "level": "child",
      "section": "典型表现",
      "position": 2,
      "content": "一是选择性搜索：只查看支持自己观点的资料，回避反面信息。二是选择性解读：同一份含糊证据，被解读为支持自己立场。三是选择性记忆：更容易回忆起印证自己判断的往事。四是标准不对称：对支持性证据宽容，对反面证据格外苛刻。",
      "content_length": 106,
      "source_position": "0-106",
      "metadata_complete": true,
      "vec_dim": 1024
    },
    {
      "chunk_id": "pilot::P-04::c004",
      "knowledge_id": "P-04",
      "namespace": "pilot",
      "level": "child",
      "section": "生活场景",
      "position": 3,
      "content": "在决定是否辞职时，如果心里已经想走，就会不断注意到公司的缺点，而自动略过尚可的部分。在评价一个人时，第一印象形成后，后续行为往往被解读成对第一印象的印证。在投资中，持仓之后更愿意阅读看多的分析，这会让风险敞口被低估。",
      "content_length": 108,
      "source_position": "0-108",
      "metadata_complete": true,
      "vec_dim": 1024
    },
    {
      "chunk_id": "pilot::P-04::c005",
      "knowledge_id": "P-04",
      "namespace": "pilot",
      "level": "child",
      "section": "应对方法",
      "position": 4,
      "content": "第一，主动寻找反证：明确问自己「什么证据会让我改变判断」。第二，事前验尸：假设决定已经失败，反推可能的原因。第三，引入异见者：请一个立场不同的人复述你的论点并提出反对。第四，先定标准后看证据：在查看资料之前先写下判断标准，避免标准随证据漂移。",
      "content_length": 121,
      "source_position": "0-121",
      "metadata_complete": true,
      "vec_dim": 1024
    },
    {
      "chunk_id": "pilot::P-04::c006",
      "knowledge_id": "P-04",
      "namespace": "pilot",
      "level": "child",
      "section": "常见误用与边界",
      "position": 5,
      "content": "确认偏差不等于「有立场」。人有立场是正常的，问题在于是否允许证据修正立场。也不宜把一切分歧都归因为对方有确认偏差——这种归因本身常常就是一种确认偏差。此外，在信息成本极高的场景中，适度依赖既有假设是有效率的，不能一概视为错误。",
      "content_length": 113,
      "source_position": "0-113",
      "metadata_complete": true,
      "vec_dim": 1024
    },
    {
      "chunk_id": "pilot::P-04::c007",
      "knowledge_id": "P-04",
      "namespace": "pilot",
      "level": "child",
      "section": "与经典思想的关系",
      "position": 6,
      "content": "苏格拉底在《申辩篇》中的「自知其无知」，与承认自身判断可能有误的态度相通；《论语》「人不知而不愠」提示不以他人认同作为判断依据；庄子「井蛙不可以语于海」描述的视野局限，与选择性搜索导致的认知封闭有结构上的相似。以上属于概念之间的联想式关联，不是经典原文对确认偏差的论述。",
      "content_length": 135,
      "source_position": "0-135",
      "metadata_complete": true,
      "vec_dim": 1024
    }
  ]
