{
  "envId": "YOUR_CLOUD_ENV_ID",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "chat",
      "timeout": 60,
      "memorySize": 512,
      "runtime": "Nodejs16.13",
      "triggers": [
        {
          "name": "keepwarm",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ],
      "envVariables": {
        "ADMIN_OPENID": "YOUR_ADMIN_OPENID",
        "KNOWLEDGE_OBSERVABILITY_STORE": "cloud",
        "FRESHNESS_ENABLED": "false",
        "FRESHNESS_FACTUAL_ENABLED": "false",
        "SEARCH_PROVIDER": "mock",
        "PRIVACY_GATE_ENABLED": "true",
        "SEARCH_CANARY_ENABLED": "false",
        "SEARCH_CANARY_OPENIDS": "YOUR_ADMIN_OPENID",
        "SEARCH_MAX_RESULTS": "5",
        "SEARCH_TIMEOUT_MS": "12000",
        "SEARCH_RETRY": "1",
        "SEARCH_DAILY_QUOTA": "500",
        "QWEN_SEARCH_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "QWEN_SEARCH_API_KEY": "sk-YOUR_API_KEY_HERE",
        "QWEN_SEARCH_MODEL": "qwen-max",
        "QWEN_SEARCH_SYNTH_MODE": "true",
        "QWEN_PLUS_ENABLED": "false",
        "QWEN_PLUS_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "QWEN_PLUS_API_KEY": "sk-YOUR_API_KEY_HERE",
        "QWEN_PLUS_MODEL": "qwen-plus",
        "QWEN_PLUS_TIMEOUT_MS": "15000",
        "KB_MODE": "kb"
      }
    },
    {
      "name": "login",
      "timeout": 10,
      "memorySize": 128,
      "runtime": "Nodejs16.13"
    },
    {
      "name": "history",
      "timeout": 20,
      "memorySize": 256,
      "runtime": "Nodejs16.13"
    },
    {
      "name": "admin",
      "timeout": 60,
      "memorySize": 256,
      "runtime": "Nodejs16.13",
      "envVariables": {
        "ADMIN_OPENID": "YOUR_ADMIN_OPENID"
      }
    },
    {
      "name": "ingest",
      "timeout": 30,
      "memorySize": 256,
      "runtime": "Nodejs16.13"
    },
    {
      "name": "feedback",
      "timeout": 10,
      "memorySize": 128,
      "runtime": "Nodejs16.13"
    }
  ]
}
